# Copia este archivo a .env (server/.env) y rellénalo. .env NO se sube a git.

# Puerto (por defecto 3002)
PORT=3002

# Contraseña de Ana María para el panel. Usa UNA de las dos:
# 1) Recomendado: hash bcrypt (ver README para generarlo). Los "$" van tal cual en este archivo.
ADMIN_PASSWORD_HASH=
# 2) Alternativa simple: texto plano (se hashea al arrancar). Solo si no defines el hash.
# ADMIN_PASSWORD=

# Secreto para firmar las sesiones (cadena larga aleatoria). Si falta, se genera uno
# al arrancar y las sesiones caducan en cada reinicio.
JWT_SECRET=
